{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-await-in-loop": "off",
    "unicorn/no-array-callback-reference": "off"
  }
}